rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everything not matched below is denied.

    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Own data only, and only with a verified email.
    function isOwner(uid) {
      return verified() && request.auth.uid == uid;
    }

    function optInt(d, key, lo, hi) {
      return !(key in d) || (d[key] is int && d[key] >= lo && d[key] <= hi);
    }
    function optChoice(d, key, choices) {
      return !(key in d) || d[key] in choices;
    }
    function numOrNull(v, lo, hi) {
      return v == null || (v is number && v >= lo && v <= hi);
    }
    function shortString(v, max) {
      return v is string && v.size() >= 1 && v.size() <= max;
    }
    function teamCode(v) {
      return v is string && v.matches('^[A-HJ-NP-Z2-9]{8}$');
    }

    function validProfile(d) {
      return d.keys().hasOnly(['displayName', 'age', 'restingHr', 'role', 'sex', 'runner',
                               'heightCm', 'weightKg', 'teamId', 'consentAt', 'updatedAt'])
        && d.keys().hasAll(['displayName', 'age', 'role', 'consentAt', 'updatedAt'])
        && shortString(d.displayName, 60)
        && d.age is int && d.age >= 13 && d.age <= 100
        && d.role in ['athlete', 'coach']
        && optInt(d, 'restingHr', 30, 120)
        && optInt(d, 'heightCm', 100, 230)
        && optInt(d, 'weightKg', 30, 250)
        && optChoice(d, 'sex', ['female', 'male'])
        && optChoice(d, 'runner', ['not a runner', 'occasional runner', 'regular runner', 'athlete'])
        && (!('teamId' in d) || teamCode(d.teamId))
        && d.consentAt is timestamp
        && d.updatedAt == request.time;
    }

    function validWindow(d) {
      return d.keys().hasOnly(['startAt', 'sessionId', 'seconds', 'label', 'activity', 'motion', 'beats',
                               'avgHr', 'minHr', 'maxHr', 'rrCv', 'avgTempC', 'avgHumidity', 'alerts', 'distanceM'])
        && d.keys().hasAll(['startAt', 'seconds', 'label', 'activity', 'beats', 'alerts'])
        && d.startAt is timestamp
        && (!('sessionId' in d) || shortString(d.sessionId, 40))
        && d.seconds is number && d.seconds > 0 && d.seconds <= 10
        && shortString(d.label, 30)
        && d.activity in ['rest', 'exercise']
        && d.get('motion', null) in [null, 'still', 'moving']
        && d.beats is int && d.beats >= 0 && d.beats <= 50
        && numOrNull(d.get('avgHr', null), 0, 300)
        && numOrNull(d.get('minHr', null), 0, 300)
        && numOrNull(d.get('maxHr', null), 0, 300)
        && numOrNull(d.get('rrCv', null), 0, 5)
        && numOrNull(d.get('avgTempC', null), 0, 60)
        && numOrNull(d.get('avgHumidity', null), 0, 100)
        && d.alerts is list && d.alerts.size() <= 10
        // 10 s at most 25 km/h is about 70 m
        && numOrNull(d.get('distanceM', null), 0, 80);
    }

    function validEvent(d) {
      return d.keys().hasOnly(['type', 'severity', 'startAt', 'endAt', 'peakHr'])
        && d.keys().hasAll(['type', 'severity', 'startAt', 'endAt', 'peakHr'])
        && d.type in ['noSignal', 'tachyRest', 'brady', 'irregular', 'aboveZone', 'dangerHr', 'highTemp']
        && d.severity in ['info', 'warning', 'medium', 'high']
        && d.startAt is timestamp
        && (d.endAt == null || d.endAt is timestamp)
        && numOrNull(d.peakHr, 0, 300);
    }

    function validTeam(d) {
      return d.keys().hasOnly(['name', 'ownerUid', 'createdAt', 'listed', 'tier', 'description',
                               'price', 'ownerName'])
        && shortString(d.name, 40)
        && d.ownerUid == request.auth.uid
        && d.get('listed', false) is bool
        && d.get('tier', 'free') in ['free', 'premium']
        && d.get('description', '') is string && d.get('description', '').size() <= 200
        && d.get('price', '') is string && d.get('price', '').size() <= 30
        && (!('ownerName' in d) || shortString(d.ownerName, 60))
        // only a profile with the coach role can run a premium team
        && (d.get('tier', 'free') != 'premium'
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach');
    }

    function team(code) {
      return get(/databases/$(database)/documents/teams/$(code)).data;
    }
    function ownsTeam(code) {
      return verified() && team(code).ownerUid == request.auth.uid;
    }
    // Free teams are open; premium teams need the owner's approval.
    function mayJoin(code, uid) {
      return team(code).get('tier', 'free') == 'free'
        || team(code).ownerUid == uid
        || get(/databases/$(database)/documents/teams/$(code)/requests/$(uid)).data.status == 'approved'
        || acceptedInvite(code, uid);
    }

    // ── Friends (Phase 1) ────────────────────────────────────────────────
    function connId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function connectionPath(a, b) {
      return /databases/$(database)/documents/connections/$(connId(a, b));
    }
    function connectedTo(uid) {
      return verified() && exists(connectionPath(request.auth.uid, uid));
    }
    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/friends/$(b));
    }
    function invitePath(code, uid) {
      return /databases/$(database)/documents/runInvites/$(code + '_' + uid);
    }
    function acceptedInvite(code, uid) {
      return exists(invitePath(code, uid))
        && get(invitePath(code, uid)).data.status == 'accepted'
        && request.time < get(invitePath(code, uid)).data.expiresAt;
    }
    function handleOk(h) {
      return h is string && h.matches('^[a-z0-9_]{3,20}$');
    }

    // ── Run posts ────────────────────────────────────────────────────────
    function myCard() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }
    function canSeePost(p) {
      return verified()
        && (p.ownerUid == request.auth.uid
            || p.visibility == 'public'
            || (p.visibility == 'friends' && areFriends(p.ownerUid, request.auth.uid)));
    }
    // Summary numbers only: never raw ECG, location or AI answers.
    function validStats(st) {
      return st is map
        && st.keys().hasOnly(['distanceM', 'seconds', 'avgHr', 'maxHr', 'alerts', 'avgTempC'])
        && st.distanceM is number && st.distanceM >= 0 && st.distanceM <= 200000
        && st.seconds is number && st.seconds > 0 && st.seconds <= 86400
        && numOrNull(st.get('avgHr', null), 0, 300)
        && numOrNull(st.get('maxHr', null), 0, 300)
        && st.alerts is int && st.alerts >= 0 && st.alerts <= 1000
        && numOrNull(st.get('avgTempC', null), 0, 60);
    }
    function postFields(d) {
      return d.keys().hasOnly(['ownerUid', 'author', 'createdAt', 'caption', 'visibility', 'stats', 'trend', 'likeCount'])
        && d.caption is string && d.caption.size() <= 280
        && d.visibility in ['public', 'friends', 'private']
        && validStats(d.stats)
        && d.trend is list && d.trend.size() <= 60
        && d.likeCount is int && d.likeCount >= 0;
    }

    // A public card: never email, health data, raw ECG or AI answers.
    function validCard(d, uid) {
      return d.keys().hasOnly(['displayName', 'searchName', 'handle', 'avatar', 'bio', 'city',
                               'runnerLevel', 'discoverable', 'updatedAt'])
        && d.keys().hasAll(['displayName', 'searchName', 'handle', 'avatar', 'discoverable', 'updatedAt'])
        && shortString(d.displayName, 60)
        && d.searchName == d.displayName.trim().lower()
        && handleOk(d.handle)
        && getAfter(/databases/$(database)/documents/handles/$(d.handle)).data.uid == uid
        && shortString(d.avatar, 16)
        && d.get('bio', '') is string && d.get('bio', '').size() <= 160
        && d.get('city', '') is string && d.get('city', '').size() <= 40
        && d.get('runnerLevel', 'casual') in ['starting', 'casual', 'regular', 'competitive']
        && d.discoverable is bool
        && d.updatedAt == request.time;
    }

    function validLocation(l) {
      return l == null
        || (l is map
            && l.keys().hasOnly(['lat', 'lng', 'accuracy', 'at'])
            && l.lat is number && l.lat >= -90 && l.lat <= 90
            && l.lng is number && l.lng >= -180 && l.lng <= 180
            && l.accuracy is number && l.accuracy >= 0
            && l.at is timestamp);
    }

    // What a member shares with their team: summaries only.
    function validMember(d) {
      return d.keys().hasOnly(['displayName', 'role', 'joinedAt', 'updatedAt', 'state', 'hr', 'alert',
                               'lastNormalHr', 'lastNormalAt', 'trend', 'session',
                               'urgent', 'location'])
        && d.keys().hasAll(['displayName', 'role', 'joinedAt', 'updatedAt', 'state'])
        && shortString(d.displayName, 60)
        && d.role in ['athlete', 'coach']
        && d.joinedAt is timestamp
        && d.updatedAt == request.time
        && d.state in ['idle', 'normal', 'alert']
        && d.get('urgent', false) is bool
        && validLocation(d.get('location', null))
        && numOrNull(d.get('hr', null), 0, 300)
        && (d.get('alert', null) == null || shortString(d.alert, 60))
        && numOrNull(d.get('lastNormalHr', null), 0, 300)
        && (d.get('lastNormalAt', null) == null || d.lastNormalAt is timestamp)
        && d.get('trend', []) is list && d.get('trend', []).size() <= 30
        && (d.get('session', null) == null
            || (d.session is map
                && d.session.keys().hasOnly(['startAt', 'minutes', 'avgHr', 'maxHr', 'alerts'])));
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && validProfile(request.resource.data);
      allow update: if isOwner(uid) && validProfile(request.resource.data)
        && request.resource.data.consentAt == resource.data.consentAt;
      allow delete: if isOwner(uid);

      match /windows/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validWindow(request.resource.data);
      }

      // mirrored on both sides when a connection is accepted
      match /friends/{fid} {
        allow read: if isOwner(uid);
        allow create: if verified() && (request.auth.uid == uid || request.auth.uid == fid)
          && request.resource.data.keys().hasOnly(['since'])
          && request.resource.data.since == request.time
          && getAfter(connectionPath(uid, fid)).data.status == 'accepted';
        allow delete: if verified() && (request.auth.uid == uid || request.auth.uid == fid)
          && !existsAfter(connectionPath(uid, fid));
      }

      match /events/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validEvent(request.resource.data);
        // an event may only be closed and have its peak updated
        allow update: if isOwner(uid) && validEvent(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endAt', 'peakHr']);
      }
    }

    // Teams: joined with the 8-character code, or from the directory when the
    // owner publishes the team. Members see each other's shared summary.
    match /teams/{code} {
      allow get: if verified();
      // the directory: only teams their owner chose to publish
      allow list: if verified() && resource.data.listed == true;
      allow create: if verified() && teamCode(code)
        && validTeam(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if verified() && resource.data.ownerUid == request.auth.uid
        && validTeam(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if verified() && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        allow read: if verified()
          && exists(/databases/$(database)/documents/teams/$(code)/members/$(request.auth.uid));
        allow create: if isOwner(uid)
          && exists(/databases/$(database)/documents/teams/$(code))
          && mayJoin(code, uid)
          && validMember(request.resource.data);
        allow update: if isOwner(uid) && validMember(request.resource.data)
          && request.resource.data.joinedAt == resource.data.joinedAt;
        // a member leaves, or the team owner removes them
        allow delete: if isOwner(uid) || ownsTeam(code);
      }

      // Applications to a premium team. Only the owner can approve.
      match /requests/{uid} {
        allow read: if isOwner(uid) || ownsTeam(code);
        allow create: if isOwner(uid)
          && team(code).get('tier', 'free') == 'premium'
          && request.resource.data.keys().hasOnly(['displayName', 'status', 'createdAt'])
          && shortString(request.resource.data.displayName, 60)
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update: if ownsTeam(code)
          && request.resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if isOwner(uid) || ownsTeam(code);
      }
    }

    // ── Public cards and handles ────────────────────────────────────────
    match /profiles/{uid} {
      // findable cards for everyone signed in; otherwise only people you are connected with
      allow get: if isOwner(uid) || (verified() && resource.data.discoverable == true) || connectedTo(uid);
      allow list: if verified() && resource.data.discoverable == true;
      allow create, update: if isOwner(uid) && validCard(request.resource.data, uid);
      allow delete: if isOwner(uid);
    }

    match /handles/{handle} {
      allow get: if verified();
      // first come, first served: an existing handle can never be overwritten
      allow create: if verified() && handleOk(handle)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.handle == handle;
      // released only once the owner's card no longer uses it
      allow delete: if verified() && resource.data.uid == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid))
            || getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.handle != handle);
    }

    // ── Connections: only the two people involved ───────────────────────
    match /connections/{cid} {
      allow read: if verified() && request.auth.uid in resource.data.users;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['users', 'requester', 'status', 'createdAt'])
        && request.resource.data.users is list && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && cid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.requester == request.auth.uid
        && request.auth.uid in request.resource.data.users
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        // you can only ask people who can find you, i.e. who chose to be findable
        && get(/databases/$(database)/documents/profiles/$(
             request.resource.data.users[0] == request.auth.uid
               ? request.resource.data.users[1] : request.resource.data.users[0])).data.discoverable == true;
      // only the other person accepts
      allow update: if verified() && request.auth.uid in resource.data.users
        && request.auth.uid != resource.data.requester
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);
      // cancel, decline or remove: either person
      allow delete: if verified() && request.auth.uid in resource.data.users;
    }

    // ── Group-run invites between friends ───────────────────────────────
    match /runInvites/{iid} {
      allow read: if verified()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'teamCode', 'teamName',
                                                 'status', 'createdAt', 'expiresAt'])
        && request.resource.data.from == request.auth.uid
        && teamCode(request.resource.data.teamCode)
        && iid == request.resource.data.teamCode + '_' + request.resource.data.to
        && areFriends(request.auth.uid, request.resource.data.to)
        && exists(/databases/$(database)/documents/teams/$(request.resource.data.teamCode)/members/$(request.auth.uid))
        && shortString(request.resource.data.fromName, 60)
        && shortString(request.resource.data.teamName, 40)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(2, 'h');
      // only the invited friend answers, before it expires
      allow update: if verified() && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.time < resource.data.expiresAt
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if verified()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // ── Run posts and likes ─────────────────────────────────────────────
    match /posts/{pid} {
      allow read: if canSeePost(resource.data);
      // the author block must match the poster's own public card
      allow create: if verified()
        && postFields(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.author.keys().hasOnly(['name', 'handle', 'avatar'])
        && request.resource.data.author.name == myCard().displayName
        && request.resource.data.author.handle == myCard().handle
        && request.resource.data.author.avatar == myCard().avatar
        && request.resource.data.createdAt == request.time
        && request.resource.data.likeCount == 0;
      // the owner edits caption and visibility only
      allow update: if verified() && resource.data.ownerUid == request.auth.uid
        && postFields(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'visibility']);
      // anyone who can see the post moves the counter by one, with their own like
      allow update: if canSeePost(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && ((request.resource.data.likeCount == resource.data.likeCount + 1
             && !exists(/databases/$(database)/documents/posts/$(pid)/likes/$(request.auth.uid))
             && existsAfter(/databases/$(database)/documents/posts/$(pid)/likes/$(request.auth.uid)))
          || (request.resource.data.likeCount == resource.data.likeCount - 1
             && exists(/databases/$(database)/documents/posts/$(pid)/likes/$(request.auth.uid))
             && !existsAfter(/databases/$(database)/documents/posts/$(pid)/likes/$(request.auth.uid))));
      allow delete: if verified() && resource.data.ownerUid == request.auth.uid;

      match /likes/{uid} {
        allow read: if canSeePost(get(/databases/$(database)/documents/posts/$(pid)).data);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/posts/$(pid)).data.likeCount
             == get(/databases/$(database)/documents/posts/$(pid)).data.likeCount + 1;
        allow delete: if isOwner(uid)
          && getAfter(/databases/$(database)/documents/posts/$(pid)).data.likeCount
             == get(/databases/$(database)/documents/posts/$(pid)).data.likeCount - 1;
      }
    }
  }
}
