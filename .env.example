# Copy this file to .env and fill in your Firebase web app config
# (Firebase console > Project settings > Your apps > pulseguard-web).
# Never commit .env.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: an App Check debug token you already registered in the console.
# Leave empty and the browser console prints a new one on `npm run dev`.
VITE_APPCHECK_DEBUG_TOKEN=

# Fraud Defense (reCAPTCHA Enterprise) site key for the hosted build.
VITE_RECAPTCHA_SITE_KEY=

# Local testing only: set to 1 to use the Auth and Firestore emulators.
VITE_USE_EMULATORS=
