{
  "name": "pulseguard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/*.test.js\"",
    "deploy": "npm test && vite build && firebase deploy --only hosting",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pulseguard \"node --test test/rules/firestore.rules.test.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore --project pulseguard-792bd"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "firebase": "^13.4.0"
  }
}
